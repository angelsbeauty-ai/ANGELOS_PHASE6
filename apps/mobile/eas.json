{
    "cli":  {
                "version":  "\u003e= 5.0.0"
            },
    "build":  {
                  "development":  {
                                      "developmentClient":  true,
                                      "distribution":  "internal",
                                      "environment":  "development",
                                      "channel":  "development",
                                      "ios":  {
                                                  "simulator":  false
                                              }
                                  },
                  "preview":  {
                                  "android":  {
                                                  "buildType":  "apk"
                                              },
                                  "distribution":  "internal"
                              },
                  "production":  {
                                     "distribution":  "store"
                                 }
              },
    "submit":  {
                   "production":  {
                                      "android":  {
                                                      "serviceAccountKeyPath":  "./google-service-account.json",
                                                      "track":  "internal"
                                                  },
                                      "ios":  {
                                                  "appleId":  "your-apple-id@example.com",
                                                  "ascAppId":  "your-app-store-connect-app-id"
                                              }
                                  }
               }
}
