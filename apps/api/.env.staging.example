# Staging environment variables. Copy values only into your hosting provider's secret settings.
PORT=3000
NODE_ENV=staging

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider
OPENAI_API_KEY=

# LiveKit: server-only. Never expose LIVEKIT_API_SECRET in Expo, GitHub, screenshots, or client code.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=900
