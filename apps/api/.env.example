# Runtime
NODE_ENV=development
PORT=3000
# Comma-separated origins. Required in production. Native apps do not rely on browser CORS,
# but this protects future web/admin clients and accidental browser exposure.
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY_HOPS=1

# Supabase - server only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI - server only
AI_PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Founder/billing controls
# Comma-separated Supabase auth user IDs allowed to bootstrap Founder Admin access.
FOUNDER_USER_IDS=
# Development only. Never enable in staging/production when real billing is connected.
BILLING_DEMO_MODE=false

# Meta (Instagram / Facebook) transport. Both the App ID/Secret and the per-workspace page
# token live in Supabase (integration_apps / oauth_connections), read with the service-role
# key only -- never here. These flags just control whether the transport may run at all.
# Leaving META_TRANSPORT_ENABLED unset keeps every Meta send path dormant.
META_TRANSPORT_ENABLED=false
# Optional: restrict live sending to a single workspace id while testing.
META_STAGING_WORKSPACE_ID=
# Shared secret you invent, then paste into the Meta App webhook setup form.
META_WEBHOOK_VERIFY_TOKEN=
