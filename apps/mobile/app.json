{
  "expo": {
    "name": "AngelOS",
    "slug": "angelos",
    "scheme": "angelos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Angelos to access photos and videos.",
          "cameraPermission": "Allow Angelos to use the camera.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.angelos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.angelos.app"
    },
    "extra": {
      "eas": {
        "projectId": "adf82555-9894-4426-87e7-5d84b662f4ac"
      }
    }
  }
}
