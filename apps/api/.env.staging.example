# AngelOS API — staging only. Copy values into Railway staging variables; do not commit real secrets.
NODE_ENV=staging
PORT=3000
CORS_ORIGINS=https://staging.example.invalid
TRUST_PROXY_HOPS=1

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Supabase auth user IDs allowed to access Founder Admin in staging.
FOUNDER_USER_IDS=

# Never use demo billing for a realistic staging acceptance pass.
BILLING_DEMO_MODE=false
